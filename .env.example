# Base URL for API
VITE_BASE_URL=https://api.payarena.com

# Auth Base URL
VITE_AUTH_BASE_URL=https://apimall.payarena.com/api/v1/

# Mall URL for SSO handoff
# Use localhost for development, production URL for live
VITE_MALL_URL=http://localhost:3000

# Encryption key for SSO token/user data encryption
# This key must be shared between the main marketplace app and the mall app
# Generate a strong, random key (at least 32 characters recommended)
# Example: openssl rand -hex 32
VITE_ENC_KEY=your-secret-encryption-key-here
